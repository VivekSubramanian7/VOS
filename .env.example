# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Telegram -----------------------------------------------------------
# From @BotFather. Long-polling only: no webhook, no public URL needed.
TELEGRAM_BOT_TOKEN=
# Only this Telegram user ID may talk to the bot. Find yours via @userinfobot.
VOS_ALLOWED_USER_ID=

# --- Model --------------------------------------------------------------
# "provider:model" — resolved by langchain init_chat_model().
#
#   anthropic:claude-opus-5        $5.00 / $25.00 per MTok
#   anthropic:claude-haiku-4-5     $1.00 / $5.00
#   google_genai:gemini-3.6-flash  $1.50 / $7.50    (GA 2026-07-21)
#   google_genai:gemini-2.5-pro    $1.25 / $10.00   (the only GA Gemini "pro")
#   ollama:llama3                  local, free
#
# Gemini notes, verified against ai.google.dev on 2026-08-08:
#  - Version-pin the ID. Gemini has no "-latest" floating alias.
#  - gemini-3.1-pro-preview is newer than 2.5-pro but is marked PREVIEW.
#  - Anything gemini-2.0-* is already shut down.
#
# Switching provider is only a config change if quality holds. with_structured_output()
# is uniform in interface, not mechanism, so after a swap run:
#     vos reclassify --dry-run --model <new spec>
VOS_MODEL=anthropic:claude-opus-5

# Key for whichever provider VOS_MODEL names. Only one is needed.
# These are read by the provider SDK from the environment, not by VOS itself —
# vos.settings loads this file into the environment so they resolve.
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=      # from aistudio.google.com/apikey  (Gemini Developer API)
# OPENAI_API_KEY=

# Daily spend ceiling in USD. On breach, capture continues and
# classification is deferred to /pending — degradation, never data loss.
VOS_DAILY_BUDGET_USD=2.00

# --- Neo4j --------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# 8+ characters. Used by BOTH the app and the container (compose derives
# NEO4J_AUTH from it), so there is only ever one copy of this secret.
#
# NOTE: Neo4j writes this password into its data volume the FIRST time the
# container starts. Changing it later has no effect until you recreate the
# volume:  docker compose down -v  &&  docker compose up -d neo4j
# (Safe to do — the graph is a projection; rebuild with `vos reclassify --rebuild`.)
NEO4J_PASSWORD=

# --- Storage ------------------------------------------------------------
VOS_JOURNAL_DIR=./journal
VOS_CASSETTE_DIR=./cassettes
# Fetched video transcripts. Like the journal, these CANNOT be recomputed — the
# upstream video can be deleted or lose its captions. Back this up.
VOS_ARTIFACT_DIR=./artifacts

# --- X pulse (optional) -------------------------------------------------
# Without this, /pulse is disabled and nothing else changes.
# Live Search bills $0.025 per source: 25 sources is ~$0.63 per digest.
XAI_API_KEY=
VOS_PULSE_MODEL=grok-4.1-fast
VOS_PULSE_MAX_SOURCES=25
VOS_PULSE_TOPIC=AI
# Exists for pointing at a compatible endpoint (e.g. a proxy). Normally leave this alone.
# VOS_XAI_BASE_URL=https://api.x.ai/v1
