# Secrets — never commit.
# The glob matters: .env.bak, .env.local, .env.prod are just as sensitive as .env,
# and a bare ".env" line does not cover them. .env.example is the one exception.
.env
.env.*
!.env.example

# Source of truth and derived data: local only
journal/
artifacts/
cassettes/
neo4j-data/
shopping.db
shopping.db-wal
shopping.db-shm

# Server-side auto-deploy log (deploy/pull-deploy.ps1)
deploy/deploy.log

# Marks THIS checkout as the deploy target. Never commit it: pull-deploy.ps1
# refuses to deploy without it, which is what keeps a dev clone from pulling
# and rebuilding itself into a second Telegram poller.
deploy/.is-server

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS / tooling caches
.vscode/
.idea/
.impeccable/
.DS_Store
Thumbs.db
